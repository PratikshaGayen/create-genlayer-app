{
  "name": "create-genlayer-app",
  "version": "0.1.0",
  "description": "Scaffold a GenLayer intelligent-contract project. Fixes the defects in `genlayer new` v0.39.1.",
  "type": "module",
  "license": "MIT",
  "author": "Pratiksha",
  "homepage": "https://github.com/PratikshaGayen/create-genlayer-app#readme",
  "bugs": {
    "url": "https://github.com/PratikshaGayen/create-genlayer-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PratikshaGayen/create-genlayer-app.git"
  },
  "keywords": [
    "genlayer",
    "genlayer-cli",
    "scaffold",
    "create",
    "intelligent-contract",
    "smart-contract",
    "llm",
    "equivalence-principle",
    "create-genlayer-app",
    "create-app"
  ],
  "bin": {
    "create-genlayer-app": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
